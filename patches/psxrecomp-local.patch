+/* CPU→VRAM upload ring (gpu.c). vram_upload_ring lists entries with
+ * seq >= "since" (default: the newest 64) whose rect overlaps the optional
+ * filter rect x0,y0..x1,y1 (inclusive), at most "n" of them. vram_upload_get
+ * returns one entry's guest-sent pixels as hex halfwords, row-major. */
+static void handle_vram_upload_ring(int id, const char *json)
+{
+    const uint32_t total = gpu_vram_upload_ring_total();
+    const uint32_t oldest = total > GPU_VRAM_UPLOAD_RING_CAP
+                          ? total - GPU_VRAM_UPLOAD_RING_CAP : 0;
+    int since = json_get_int(json, "since", (int)(total > 64 ? total - 64 : 0));
+    int n = json_get_int(json, "n", 256);
+    const int x0 = json_get_int(json, "x0", 0), y0 = json_get_int(json, "y0", 0);
+    const int x1 = json_get_int(json, "x1", 1023), y1 = json_get_int(json, "y1", 511);
+    if (n < 1) n = 1;
+    if (n > GPU_VRAM_UPLOAD_RING_CAP) n = GPU_VRAM_UPLOAD_RING_CAP;
+    uint32_t seq = since < 0 ? 0u : (uint32_t)since;
+    if (seq < oldest) seq = oldest;
+
+    size_t bufsz = 256u + (size_t)n * 256u;
+    char *buf = (char *)malloc(bufsz);
+    if (!buf) { send_err(id, "alloc failed"); return; }
+    size_t pos = (size_t)snprintf(buf, bufsz,
+        "{\"id\":%d,\"ok\":true,\"total\":%u,\"oldest\":%u,\"entries\":[",
+        id, total, oldest);
+    int emitted = 0;
+    for (; seq < total && emitted < n; seq++) {
+        GpuVramUploadInfo e;
+        if (!gpu_vram_upload_ring_get(seq, &e, NULL)) continue;
+        /* Rect overlap test; uploads wrap at the VRAM edge, ignored here. */
+        if (e.x > x1 || e.x + e.w - 1 < x0 || e.y > y1 || e.y + e.h - 1 < y0)
+            continue;
+        pos += (size_t)snprintf(buf + pos, bufsz - pos,
+            "%s{\"seq\":%u,\"frame\":%u,\"func\":\"0x%08X\",\"x\":%u,\"y\":%u,"
+            "\"w\":%u,\"h\":%u,\"px_seen\":%u,\"px_stored\":%u,"
+            "\"mask_skipped\":%u,\"set_mask\":%u,\"check_mask\":%u,"
+            "\"complete\":%u}",
+            emitted ? "," : "", e.seq, e.frame, e.func, e.x, e.y, e.w, e.h,
+            e.px_seen, e.px_stored, e.mask_skipped, e.set_mask, e.check_mask,
+            e.complete);
+        emitted++;
+    }
+    snprintf(buf + pos, bufsz - pos, "],\"next\":%u}", seq);
+    debug_server_send_line(buf);
+    free(buf);
+}
+
+static void handle_vram_upload_get(int id, const char *json)
+{
+    const int seq = json_get_int(json, "seq", -1);
+    GpuVramUploadInfo e;
+    const uint16_t *px = NULL;
+    if (seq < 0 || !gpu_vram_upload_ring_get((uint32_t)seq, &e, &px)) {
+        send_err(id, "seq not in ring"); return;
+    }
+    size_t bufsz = 512u + (size_t)e.px_stored * 4u;
+    char *buf = (char *)malloc(bufsz);
+    if (!buf) { send_err(id, "alloc failed"); return; }
+    size_t pos = (size_t)snprintf(buf, bufsz,
+        "{\"id\":%d,\"ok\":true,\"seq\":%u,\"frame\":%u,\"func\":\"0x%08X\","
+        "\"x\":%u,\"y\":%u,\"w\":%u,\"h\":%u,\"px_seen\":%u,\"px_stored\":%u,"
+        "\"mask_skipped\":%u,\"set_mask\":%u,\"check_mask\":%u,\"complete\":%u,"
+        "\"hex\":\"",
+        id, e.seq, e.frame, e.func, e.x, e.y, e.w, e.h, e.px_seen,
+        e.px_stored, e.mask_skipped, e.set_mask, e.check_mask, e.complete);
+    static const char hexd[] = "0123456789abcdef";
+    for (uint32_t i = 0; i < e.px_stored; i++) {
+        const uint16_t p = px[i];
+        buf[pos++] = hexd[(p >> 12) & 15]; buf[pos++] = hexd[(p >> 8) & 15];
+        buf[pos++] = hexd[(p >> 4) & 15];  buf[pos++] = hexd[p & 15];
+    }
+    snprintf(buf + pos, bufsz - pos, "\"}");
+    debug_server_send_line(buf);
+    free(buf);
+}
