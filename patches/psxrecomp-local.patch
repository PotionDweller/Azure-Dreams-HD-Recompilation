+/* Local patch (AzureDreamsRecomp): bulk card-transfer counter, the load
+ * signal for Fast Loading host pacing (main.cpp). Save/load menus poll the
+ * card by re-reading the same directory/icon sectors over and over, while a
+ * real save writes and a real load reads a run of sectors once each. So a
+ * transfer counts as bulk if it is a write, or a read of a sector that was not
+ * read in the last MC_FRESH_READ_CYCLES of guest time (guest time, so the
+ * window is independent of how fast pacing runs). Host-only bookkeeping: it
+ * never changes what the guest sees. */
+#define MC_FRESH_READ_CYCLES (4ull * 33868800ull)   /* ~4 s of guest time */
+static uint64_t s_mc_sector_last_read[2][MEMCARD_SECTORS];  /* 0 = never */
+static int      s_mc_bulk_count = 0;
+static void mc_note_transfer(int slot, uint8_t cmd, uint16_t sector) {
+    extern uint64_t psx_get_cycle_count(void);
+    if (cmd == 0x57) { s_mc_bulk_count++; return; }
+    if (cmd != 0x52 || slot < 0 || slot > 1 || sector >= MEMCARD_SECTORS) return;
+    const uint64_t now  = psx_get_cycle_count() + 1u;   /* keep 0 = never */
+    const uint64_t last = s_mc_sector_last_read[slot][sector];
+    if (last == 0 || now - last > MC_FRESH_READ_CYCLES) s_mc_bulk_count++;
+    s_mc_sector_last_read[slot][sector] = now;
+}
